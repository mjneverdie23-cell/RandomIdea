; Raptor Strike - tactical dinosaur shooter prototype
; Godot 4.7 project. Open this folder with the Godot editor and press F5.

config_version=5

[application]

config/name="Raptor Strike"
config/description="Tactical dinosaur shooter prototype: CS-style objective rounds, hero-shooter classes."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
Config="*res://autoload/config.gd"
Game="*res://autoload/game.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

