<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the Unity project's engine-free core (Scripts/Core) and its EditMode tests with the
    plain .NET SDK, so the rules can be tested without opening Unity:

        dotnet test tools/dotnet-core-tests

    LangVersion is pinned to 9.0, the newest C# that Unity 2022.3 / Unity 6 compile.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NUnit2005;NUnit2007;CS8321</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/Assets/TacticalShooter/Scripts/Core/**/*.cs" />
    <Compile Include="../../unity/Assets/TacticalShooter/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
