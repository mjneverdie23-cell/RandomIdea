__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env

# Cached downloads and derived data: rebuild with scripts/build_dataset.py.
# The directories are kept (via .gitkeep) so a fresh clone has somewhere to write.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained artefacts: rebuild with scripts/train.py
models/*
!models/.gitkeep

frontend/node_modules/
frontend/dist/
.DS_Store
