# Copy to .env and adjust. Every value has a working default, so an empty
# .env is fine for local use.

# --- paths ---------------------------------------------------------------
# Override where the project reads and writes. Defaults are relative to the
# repository root.
# FP_PROJECT_ROOT=/srv/football-predictor
# FP_CONFIG_DIR=/srv/football-predictor/config
# FP_DATA_DIR=/srv/football-predictor/data
# FP_MODEL_DIR=/srv/football-predictor/models

# --- API -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- frontend ------------------------------------------------------------
# Where the browser should reach the API. In development Vite proxies /api to
# API_HOST:API_PORT, so this only needs setting for a deployed build.
# VITE_API_BASE=https://predictor.example.com

# --- storage -------------------------------------------------------------
# The pipeline stores the match table as parquet under data/processed by
# default. Set a database URL only if you wire the optional SQL store.
# DATABASE_URL=sqlite:///data/processed/football.db
